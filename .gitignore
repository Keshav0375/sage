# harness runtime: traces, builder ledger, context packs, drafts. Local only.
projects/.runtime/
# the running session may still write here until it restarts with the new context_dir
context/

# raw downloads (PDF, HTML, ZIP) agents fetched; the library index and research notes are committed
projects/*/library/files/

# generated mod types
plugins/*/.claude-plugin/types/
plugins/*/tsconfig.json

__pycache__/
*.pyc
node_modules/
.DS_Store
.claude/settings.local.json
.env
.env.*
*.pem
*.key

# Personal resume files: never publish (contact info)
memory/resume/*.pdf
memory/resume/out/
memory/resume/contact.tex
memory/resume/**/*.pdf
memory/resume/runs/
memory/resume/market/jobs-index.jsonl
memory/resume/**/build.log
memory/resume/**/resume.cls
memory/resume/**/*.log
