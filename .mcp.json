{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headersHelper": "printf '{\"Authorization\":\"Bearer %s\",\"X-MCP-Toolsets\":\"repos,pull_requests,actions,issues\"}' \"$(gh auth token)\""
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "reddit": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "reddit-mcp-buddy@latest"]
    }
  }
}
